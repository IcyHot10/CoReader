rules_version = '2';

// CoReader Firestore security rules.
//
// Schema:
//   users/{uid}                                              private: email, library, settings
//   users/{uid}/books/{bookId}                               book marker (makes annotations enumerable)
//   users/{uid}/books/{bookId}/annotations/{id}              personal highlights and notes
//   profiles/{uid}                                           public display name only
//   groups/{code}                                            name + members
//   groupBooks/{code}                                         per-member reading progress
//   groupBooks/{code}/books/{bookId}                          book marker
//   groupBooks/{code}/books/{bookId}/annotations/{id}         shared highlights and notes
//   userStats/{uid}                                           reading stats
//   readingLists/{uid}                                        to-read list
//
// Note: rules do NOT cascade into subcollections. Every subcollection above needs its own
// match block, which is why the annotation paths are spelled out rather than covered by the
// parent document's rule.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function groupMembers(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.groupMembers;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && request.auth.uid in groupMembers(groupId);
    }

    function isGroupAdmin(groupId) {
      return isGroupMember(groupId)
             && groupMembers(groupId)[request.auth.uid].get('admin', false) == true;
    }

    // Only these keys changed, at the top level of the document.
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ------------------------------------------------------------------ users

    match /users/{userId} {
      function removedGroups() {
        return resource.data.groupIDs.removeAll(request.resource.data.groupIDs);
      }

      // Read is now owner-only. Display names moved to profiles/{uid}, so no other member
      // ever needs to read this document — which is what kept `email` exposed to anyone
      // who knew a uid.
      allow read: if isSelf(userId);

      allow write: if isSelf(userId)
                   && "email" in request.resource.data;

      // A group admin removing another member has to clear that member's membership fields,
      // and a client cannot otherwise write another user's document.
      //
      // Scoped precisely: exactly one group code may leave groupIDs, the caller must be an
      // admin of that specific group, and no field other than the two membership fields may
      // change. The removed code is recovered from the diff, since rules cannot iterate a list
      // to find a group the caller happens to administer.
      //
      // This is the only place one user may write another's document. Moving member removal
      // into a Cloud Function would let you delete this block.
      allow update: if isSignedIn()
                    && changedOnly(['groupIDs', 'activeGroup'])
                    && removedGroups().size() == 1
                    && isGroupAdmin(removedGroups()[0])
                    && (request.resource.data.activeGroup == ''
                        || request.resource.data.activeGroup in request.resource.data.groupIDs);

      // Personal annotations. The marker document exists so the annotations subcollection can
      // be enumerated; neither holds anything the owner cannot already read.
      match /books/{bookId} {
        allow read, write: if isSelf(userId);

        match /annotations/{annotationId} {
          allow read, write: if isSelf(userId);
        }
      }
    }

    // ------------------------------------------------------------------ profiles

    // Public display names. Readable by any signed-in user so group screens can resolve
    // member names; writable only by the owner, and only the username field.
    match /profiles/{userId} {
      allow read: if isSignedIn();

      allow write: if isSelf(userId)
                   && request.resource.data.keys().hasOnly(['username'])
                   && request.resource.data.username is string
                   && request.resource.data.username.size() > 0
                   && request.resource.data.username.size() <= 64;
    }

    // ------------------------------------------------------------------ stats, reading list

    match /userStats/{userId} {
      allow read, write: if isSelf(userId);
    }

    match /readingLists/{userId} {
      allow read, write: if isSelf(userId);
    }

    match /ai_suggestions_requests/{id} {
      allow read, write: if isSignedIn();
    }

    // ------------------------------------------------------------------ groups

    match /groups/{groupId} {
      // Any signed-in user may look a code up — that is how joining works, and how
      // generateUniqueCode checks a candidate code is free.
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.groupMembers;

      // Existing members may update the group (promote, remove a member) — unchanged from
      // your original rule, so whatever the UI currently allows keeps working.
      //
      // OPTIONAL HARDENING: the app only ever needs an admin to change membership, and the
      // self-only rule below already covers joining and leaving. Narrowing this line to
      //   allow update: if isGroupAdmin(groupId);
      // would stop any member from promoting themselves or removing anyone else. Check the
      // group screen gates those buttons on isAdmin before switching.
      allow update: if isGroupMember(groupId);

      // Joining and leaving: a user may add or remove themselves, and only themselves, in
      // groupMembers. Without this a new member could never write their own entry, because
      // the membership check above is evaluated against the pre-write document — joining a
      // group could not have worked under the previous rules.
      allow update: if isSignedIn()
                    && changedOnly(['groupMembers'])
                    && request.resource.data.groupMembers
                         .diff(resource.data.groupMembers)
                         .affectedKeys()
                         .hasOnly([request.auth.uid]);

      allow delete: if isSignedIn()
                    && (request.auth.uid in resource.data.groupMembers
                        || resource.data.groupMembers.size() == 0);
    }

    // ------------------------------------------------------------------ group books

    match /groupBooks/{groupId} {
      allow read, create, update: if isSignedIn()
        && groupId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupIDs;

      allow delete: if isSignedIn()
        && (groupId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupIDs
            || !exists(/databases/$(database)/documents/groups/$(groupId)));

      match /books/{bookId} {
        allow read, write: if isGroupMember(groupId);

        match /annotations/{annotationId} {
          // Read is deliberately independent of document contents: a rule that checked
          // ownerUid here would reject the whole annotations query, since rules filter
          // nothing — they only accept or reject.
          allow read: if isGroupMember(groupId);

          // A member creates only their own annotations.
          allow create: if isGroupMember(groupId)
                        && request.auth.uid == request.resource.data.ownerUid;

          // The owner may edit their own annotation. Any member may append or remove a reply,
          // which is the only legitimate reason to write someone else's document — and nothing
          // may reassign ownership.
          allow update: if isGroupMember(groupId)
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && (request.auth.uid == resource.data.ownerUid
                            || changedOnly(['replies']));

          allow delete: if isGroupMember(groupId)
                        && (request.auth.uid == resource.data.ownerUid
                            || isGroupAdmin(groupId));
        }
      }
    }
  }
}
